# Szablon stagingu Hostinger. Lokalnie zachowaj własny, ignorowany .env.
APP_NAME="Eat The Ball"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://test.eattheball.pl
APP_TIMEZONE=Europe/Warsaw
APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL
APP_MAINTENANCE_DRIVER=file
# Wygeneruj APP_KEY osobno na serwerze. Nie zmieniaj go przy aktualizacjach.
# Nie ustawiaj * bez potwierdzenia konfiguracji reverse proxy Hostingera.
TRUSTED_PROXIES=

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1
PASSWORD_MIN_LENGTH=15
PASSWORD_MAX_LENGTH=128
REGISTRATION_CODE_TTL=10
REGISTRATION_CODE_MAX_ATTEMPTS=5

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=PLACEHOLDER
DB_PORT=3306
DB_DATABASE=PLACEHOLDER
DB_USERNAME=PLACEHOLDER
DB_PASSWORD=PLACEHOLDER
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=etb_staging_session
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
CACHE_STORE=database
CACHE_PREFIX=etb_staging_cache_

# SMTP: port 587 + tls (STARTTLS), albo port 465 + ssl (SMTPS).
# MAIL_SCHEME jest opcjonalne; jeśli podane, ma pierwszeństwo (smtp/smtps).
MAIL_MAILER=smtp
MAIL_HOST=PLACEHOLDER
MAIL_PORT=587
MAIL_USERNAME=PLACEHOLDER
MAIL_PASSWORD=PLACEHOLDER
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS=poczta@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Opcjonalna analityka. Puste ID wyłącza integrację.
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_ANALYTICS_DEBUG=false
POLISH_HOLIDAYS_ENABLED=true
NAGER_DATE_BASE_URL=https://date.nager.at

# Sklep: przed sprzedażą usuń blokery opisane w DEPLOYMENT.md.
# Puste sekrety nie uruchamiają prawdziwej integracji.
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC_KEY=
P24_API_KEY=
P24_BASE_URL=https://sandbox.przelewy24.pl
P24_RETURN_URL=https://test.eattheball.pl/checkout/confirmation
P24_STATUS_URL=https://test.eattheball.pl/payment/przelewy24/webhook
SHIPPING_PROVIDER=inpost
INPOST_API_TOKEN=
INPOST_BASE_URL=https://api.inpost.pl
DPD_API_KEY=
DPD_LOGIN=
DPD_PASSWORD=
DPD_BASE_URL=https://dpd.com.pl/api
INVOICE_SELLER_NAME=PLACEHOLDER
INVOICE_SELLER_ADDRESS=PLACEHOLDER
INVOICE_SELLER_NIP=PLACEHOLDER

# Opcjonalne S3/R2; niewymagane przy MEDIA_DISK=public.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Zmienne VITE_* są publiczne. Nigdy nie umieszczaj tu sekretów.
VITE_APP_NAME="${APP_NAME}"